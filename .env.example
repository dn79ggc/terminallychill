# Copy to .env for local use. NEVER commit .env.
# On the Vultr VM the real values live in /etc/airport-rest-finder/env (root-owned, chmod 600).

# Which flight-data source to use. ONE provider per run, never merged.
#   aeroapi | aviationstack | snapshot   (snapshot = synthetic sample, no key needed)
FLIGHT_PROVIDER=aeroapi

AEROAPI_KEY=
AVIATIONSTACK_KEY=

# Hard caps on result pages per ingest run (AeroAPI: 1 page = 15 flights, billed per page)
AEROAPI_MAX_PAGES=3
AVIATIONSTACK_MAX_PAGES=3

# Tiger Data connection string, copied from the service's connection details.
# Looks like: postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=
